{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Pi keybindings configuration",
  "description": "Keybindings for ~/.pi/agent/keybindings.json. Values can be a key id string or an array of key id strings.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema for editor autocomplete."
    },
    "tui.editor.cursorUp": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move cursor up Default: up."
    },
    "tui.editor.cursorDown": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move cursor down Default: down."
    },
    "tui.editor.cursorLeft": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move cursor left Default: left, ctrl+b."
    },
    "tui.editor.cursorRight": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move cursor right Default: right, ctrl+f."
    },
    "tui.editor.cursorWordLeft": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move cursor word left Default: alt+left, ctrl+left, alt+b."
    },
    "tui.editor.cursorWordRight": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move cursor word right Default: alt+right, ctrl+right, alt+f."
    },
    "tui.editor.cursorLineStart": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move to line start Default: home, ctrl+a."
    },
    "tui.editor.cursorLineEnd": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move to line end Default: end, ctrl+e."
    },
    "tui.editor.jumpForward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Jump forward to character Default: ctrl+]."
    },
    "tui.editor.jumpBackward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Jump backward to character Default: ctrl+alt+]."
    },
    "tui.editor.pageUp": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Page up Default: pageUp."
    },
    "tui.editor.pageDown": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Page down Default: pageDown."
    },
    "tui.editor.deleteCharBackward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete character backward Default: backspace."
    },
    "tui.editor.deleteCharForward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete character forward Default: delete, ctrl+d."
    },
    "tui.editor.deleteWordBackward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete word backward Default: ctrl+w, alt+backspace."
    },
    "tui.editor.deleteWordForward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete word forward Default: alt+d, alt+delete."
    },
    "tui.editor.deleteToLineStart": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete to line start Default: ctrl+u."
    },
    "tui.editor.deleteToLineEnd": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete to line end Default: ctrl+k."
    },
    "tui.editor.yank": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Yank Default: ctrl+y."
    },
    "tui.editor.yankPop": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Yank pop Default: alt+y."
    },
    "tui.editor.undo": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Undo Default: ctrl+-."
    },
    "tui.input.newLine": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Insert newline Default: shift+enter."
    },
    "tui.input.submit": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Submit input Default: enter."
    },
    "tui.input.tab": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tab / autocomplete Default: tab."
    },
    "tui.input.copy": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Copy selection Default: ctrl+c."
    },
    "tui.select.up": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move selection up Default: up."
    },
    "tui.select.down": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move selection down Default: down."
    },
    "tui.select.pageUp": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Selection page up Default: pageUp."
    },
    "tui.select.pageDown": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Selection page down Default: pageDown."
    },
    "tui.select.confirm": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Confirm selection Default: enter."
    },
    "tui.select.cancel": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Cancel selection Default: escape, ctrl+c."
    },
    "app.interrupt": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Cancel or abort Default: escape."
    },
    "app.clear": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Clear editor Default: ctrl+c."
    },
    "app.exit": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Exit when editor is empty Default: ctrl+d."
    },
    "app.suspend": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Suspend to background Default: ctrl+z."
    },
    "app.thinking.cycle": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Cycle thinking level Default: shift+tab."
    },
    "app.model.cycleForward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Cycle to next model Default: ctrl+p."
    },
    "app.model.cycleBackward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Cycle to previous model Default: shift+ctrl+p."
    },
    "app.model.select": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Open model selector Default: ctrl+l."
    },
    "app.tools.expand": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Toggle tool output Default: ctrl+o."
    },
    "app.thinking.toggle": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Toggle thinking blocks Default: ctrl+t."
    },
    "app.session.toggleNamedFilter": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Toggle named session filter Default: ctrl+n."
    },
    "app.editor.external": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Open external editor Default: ctrl+g."
    },
    "app.message.followUp": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Queue follow-up message Default: alt+enter."
    },
    "app.message.dequeue": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Restore queued messages Default: alt+up."
    },
    "app.clipboard.pasteImage": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Paste image from clipboard Default: ctrl+v."
    },
    "app.session.new": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Start a new session No default binding."
    },
    "app.session.tree": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Open session tree No default binding."
    },
    "app.session.fork": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Fork current session No default binding."
    },
    "app.session.resume": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Resume a session No default binding."
    },
    "app.tree.foldOrUp": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Fold tree branch or move up Default: ctrl+left, alt+left."
    },
    "app.tree.unfoldOrDown": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Unfold tree branch or move down Default: ctrl+right, alt+right."
    },
    "app.tree.editLabel": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Edit tree label Default: shift+l."
    },
    "app.tree.toggleLabelTimestamp": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Toggle tree label timestamps Default: shift+t."
    },
    "app.session.togglePath": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Toggle session path display Default: ctrl+p."
    },
    "app.session.toggleSort": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Toggle session sort mode Default: ctrl+s."
    },
    "app.session.rename": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Rename session Default: ctrl+r."
    },
    "app.session.delete": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete session Default: ctrl+d."
    },
    "app.session.deleteNoninvasive": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Delete session when query is empty Default: ctrl+backspace."
    },
    "app.models.save": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Save model selection Default: ctrl+s."
    },
    "app.models.enableAll": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Enable all models Default: ctrl+a."
    },
    "app.models.clearAll": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Clear all models Default: ctrl+x."
    },
    "app.models.toggleProvider": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Toggle all models for provider Default: ctrl+p."
    },
    "app.models.reorderUp": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move model up in order Default: alt+up."
    },
    "app.models.reorderDown": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Move model down in order Default: alt+down."
    },
    "app.tree.filter.default": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tree filter: default view Default: ctrl+d."
    },
    "app.tree.filter.noTools": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tree filter: hide tool results Default: ctrl+t."
    },
    "app.tree.filter.userOnly": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tree filter: user messages only Default: ctrl+u."
    },
    "app.tree.filter.labeledOnly": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tree filter: labeled entries only Default: ctrl+l."
    },
    "app.tree.filter.all": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tree filter: show all entries Default: ctrl+a."
    },
    "app.tree.filter.cycleForward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tree filter: cycle forward Default: ctrl+o."
    },
    "app.tree.filter.cycleBackward": {
      "$ref": "#/definitions/keybindingValue",
      "description": "Tree filter: cycle backward Default: shift+ctrl+o."
    }
  },

{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10,
    "directTools": false
  },
  "mcpServers": {
    "playwriter": {
      "command": "npx",
      "args": [
        "-y",
        "playwriter@latest"
      ],
      "env": {
        "PLAYWRITER_AUTO_ENABLE": "1"
      },
      "lifecycle": "lazy"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "lifecycle": "lazy"
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    }
  }
}

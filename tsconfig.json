{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node", "vitest"]
  },
  "include": ["examples/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
